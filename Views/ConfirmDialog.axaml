<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZarodeurLauncher.Views.ConfirmDialog"
        Width="450"
        Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Confirmation">

    <Grid Margin="25"
          RowDefinitions="*,Auto">

        <StackPanel Spacing="10">

            <TextBlock Text="Effacer les logs ?"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Cette action supprimera tous les logs enregistrés aujourd'hui."
                       TextWrapping="Wrap"
                       Opacity="0.7"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button Content="Annuler"
                    Width="100"
                    Click="Cancel_Click"/>

            <Button Content="Effacer"
                    Width="100"
                    Click="Confirm_Click"/>

        </StackPanel>

    </Grid>

</Window>