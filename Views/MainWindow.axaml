<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZarodeurLauncher.ViewModels"
        x:Class="ZarodeurLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="550"
        MinWidth="700"
        MinHeight="450"
        Title="Zarodeur Launcher">

    <Window.Styles>

        <!-- TITRE -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- SOUS-TITRE -->
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- BOUTON JOUER -->
        <Style Selector="Button.play-button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="35,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>

        <!-- BARRE DE PROGRESSION -->
        <Style Selector="ProgressBar.modpack-progress">
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

    </Window.Styles>


    <Grid RowDefinitions="Auto,*,Auto"
          Margin="40">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <StackPanel Grid.Row="0"
                    Spacing="5">

            <TextBlock Text="ZARODEUR"
                       Classes="title"/>

            <TextBlock Text="Minecraft Launcher"
                       Classes="subtitle"/>

        </StackPanel>


        <!-- ========================= -->
        <!-- CONTENU PRINCIPAL -->
        <!-- ========================= -->

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="420">

            <StackPanel Spacing="12"
                        HorizontalAlignment="Stretch">

                <!-- VERSION -->
                <TextBlock Text="Minecraft 1.20.1"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Forge 47.4.0"
                           FontSize="18"
                           Opacity="0.7"
                           HorizontalAlignment="Center"/>


                <!-- BOUTON -->
                <Button Content="JOUER"
                        Classes="play-button"
                        Margin="0,25,0,5"
                        Command="{Binding PrepareMinecraftCommand}"
                        IsEnabled="{Binding !IsBusy}"/>


                <!-- PROGRESSION -->
                <ProgressBar Value="{Binding Progress}"
                             Minimum="0"
                             Maximum="100"
                             Classes="modpack-progress"
                             IsVisible="{Binding IsBusy}"/>


                <!-- POURCENTAGE -->
                <TextBlock
                    Text="{Binding Progress, StringFormat='{}{0:0}%'}"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Opacity="0.8"
                    IsVisible="{Binding IsBusy}"/>


                <!-- STATUT -->
                <TextBlock Text="{Binding Status}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ========================= -->
        <!-- FOOTER -->
        <!-- ========================= -->

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto">

            <TextBlock Grid.Column="0"
                       Text="Minecraft 1.20.1 • Forge 47.4.0"
                       VerticalAlignment="Center"
                       Opacity="0.5"/>

            <TextBlock Grid.Column="1"
                       Text="Zarodeur Launcher"
                       Opacity="0.5"/>

        </Grid>

    </Grid>

</Window>